#!/usr/bin/env bash
set -euo pipefail
ENV_FILE=/etc/default/pve-host-backup
# shellcheck disable=SC1090
[ -r "$ENV_FILE" ] && . "$ENV_FILE"          # optional: KUMA_PUSH_URL=https://watch.mikkel.cc/api/push/<token>

export PBS_REPOSITORY='pve@pbs!pvesm@192.168.6.205:main'
export PBS_PASSWORD="$(cat /etc/pve/priv/storage/pbs-main.pw)"
export PBS_FINGERPRINT='0b:1f:36:0d:c6:94:51:01:17:3e:36:e8:d0:e9:12:29:d1:cd:74:b7:b7:8e:a4:74:fe:f3:44:e2:9f:de:63:9d'

meta=/var/lib/pve-host-backup
{
  echo "# generated $(date -Is)"
  echo "## pveversion -v";    pveversion -v
  echo "## qm list";          qm list
  echo "## pct list";         pct list
  echo "## zfs list";         zfs list -o name,used,avail,quota,mountpoint
  echo "## zpool status";     zpool status
  echo "## lsblk";            lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT,SERIAL
  echo "## ip addr";          ip -br addr
  echo "## pvesm status";     pvesm status 2>&1 || true
} > "$meta/inventory.txt" 2>&1

proxmox-backup-client backup \
  etc.pxar:/etc \
  pve.pxar:/etc/pve \
  meta.pxar:"$meta" \
  --backup-type host --backup-id "$(hostname)"

if [ -n "${KUMA_PUSH_URL:-}" ]; then
  curl -fsS -m 10 "${KUMA_PUSH_URL%%\?*}?status=up&msg=OK" >/dev/null || true
fi
