# {{ansible_managed}}

{
	# Requests arriving from Cloudflare's ranges are trusted to say who the real
	# visitor is. Direct (DNS-only) clients are never in these ranges, so they
	# cannot spoof a client IP. Sites pass {client_ip} on to their backends.
	servers {
		trusted_proxies static {{ cloudflare_ips | join(' ') }}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

import "/etc/caddy/sites/*.Caddyfile"

mikkel.cc {
	tls mikkel@mikkel.cc {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
}
