# {{ansible_managed}}

# LAN only for now: there is no public DNS record, the name is resolved on the
# LAN (and over WireGuard). The certificate comes from the DNS challenge, so it
# needs no inbound access. To publish it, add a DNS-only CNAME to home.mikkel.cc.
{{ inventree_domain }} {
    log
	tls mikkel@mikkel.cc {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
    encode zstd gzip
    reverse_proxy http://127.0.0.1:{{ portmap.inventree[0] }}
}
