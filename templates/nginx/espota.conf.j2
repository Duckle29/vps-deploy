# {{ansible_managed}}

# ESP OTA update server. The ESP's TLS stack has a small receive buffer, so every
# TLS record must be at most 512 bytes. Plain HTTP/1.1, no HTTP/2, no compression.
server {
    listen {{ portmap.esp_ota[1] }} ssl;
    listen [::]:{{ portmap.esp_ota[1] }} ssl;
    server_name {{ esp_ota_host }};

    ssl_certificate     {{ esp_ota_caddy_dir }}/{{ esp_ota_host }}.crt;
    ssl_certificate_key {{ esp_ota_caddy_dir }}/{{ esp_ota_host }}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_buffer_size 512;
    ssl_session_tickets off;

    gzip off;
    sendfile off;
    client_max_body_size 5M;
    access_log /var/log/nginx/espota.access.log;

    auth_basic "ESP updater";
    auth_basic_user_file {{ esp_ota_dir }}/.htpasswd;

    location / {
        proxy_pass http://127.0.0.1:{{ portmap.esp_ota[0] }};
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
