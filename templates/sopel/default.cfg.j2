# '{{ansible_managed}}'

[core]
prefix = \$
help_prefix = \$

nick = DumDuckBot
auth_username = {{ credentials.sopel.sopel_irc_user }}
auth_password = {{ credentials.sopel.sopel_irc_pass }}
auth_method = sasl

log_raw = false
logdir = /home/sopel/.sopel/log
pid_dir = /home/sopel/.sopel

host = irc.libera.chat
use_ssl = true
verify_ssl = true
port = 6697

owner = Duckle
owner_account = Duckle
channels =
    "##botspam"
    "#reprap"
    #"##electronics"
nick_blocks =
    mcrib
    ghtx
    electrobot

host_blocks =

enable =
    help
    admin
    reload
    currency
    xkcd
    wolfram
    #youtube

[admin]
hold_ground = false
auto_accept_invite = true

[wikipedia]
default_lang = en

[wolfram]
app_id = {{ credentials.sopel.wolfram_alpha_key }}
max_public = 3
units = metric

[currency]
fixer_io_key = {{ credentials.sopel.fixer_io_key }}
auto_convert = true

[youtube]
api_key = {{ credentials.sopel.youtube_api_key }}
info_items =
  length
  date
  views
  uploader
playlist_watch = true