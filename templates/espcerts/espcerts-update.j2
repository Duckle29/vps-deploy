#!/usr/bin/env bash
# {{ ansible_managed }}
# Rebuilds certs.ar and reports the result to a Kuma push monitor. A failed
# build pushes status=down with the reason; if this never runs (timer, host or
# network dead) the monitor goes down by itself when the heartbeat is missed.
set -uo pipefail
ENV_FILE=/etc/default/espcerts
# shellcheck disable=SC1090
[ -r "$ENV_FILE" ] && . "$ENV_FILE"   # KUMA_URL (may be unset)

push() {  # status msg
  [ -n "${KUMA_URL:-}" ] || return 0
  curl -fsS -m 10 -G "${KUMA_URL%%\?*}" --data-urlencode "status=$1" \
    --data-urlencode "msg=$2" >/dev/null || echo "push failed: $2" >&2
}

out=$(/usr/bin/python3 /usr/local/bin/espcerts-bundle --tls-only --output "{{ esp_certs_dir }}/certs.ar" 2>&1)
rc=$?
echo "$out"
last=$(grep -v '^$' <<<"$out" | tail -n 1)
if [ $rc -eq 0 ]; then
  push up "$last"
else
  push down "bundle build failed (rc $rc): ${last:-no output}"
fi
exit $rc
